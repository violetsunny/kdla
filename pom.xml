    <properties>
        <!--基础配置 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <java.version>21</java.version>
        <kdla.framework.version>2.0.1-SNAPSHOT</kdla.framework.version>
        <!--基础配置 -->
        <!--架构配置 -->
        <!--spring.boot3.2.0以上是Spring-6.2,jdk版本要求至少jdk21以上,对maven版本的要求是3.8.6以上;-->
        <!--spring.cloud2023.0.0以上是spring.boot3.2.0 -->
        <!--
        https://start.spring.io/actuator/infoc
        "spring-ai": {
          "1.0.0-RC1": "Spring Boot >=3.4.0 and < 3.6.0-M1"
        },
        "spring-cloud": {
          "2023.0.5": "Spring Boot >=3.3.0 and < 3.4.0-M1",
          "2024.0.1": "Spring Boot >=3.4.0 and < 3.5.0-M1",
          "2025.0.0-RC1": "Spring Boot >=3.5.0-M1 and < 3.6.0-M1"
        }
        -->
        <spring.boot.version>3.4.0</spring.boot.version> <!-- Spring Boot 3.2.0 及以上支持 JDK 21 -->
        <spring.cloud.version>2024.0.1</spring.cloud.version> <!-- Spring Cloud 2023.0.0 及以上支持 Spring Boot 3.2.0+ -->
        <!-- mybatis-spring-boot-starter的版本需要和spring-boot-starter匹配
        "mybatis": {
          "3.0.4": "Spring Boot >=3.3.0 and < 3.5.0-M1"
        }
        -->
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <mybatis-plus-boot.version>3.5.12</mybatis-plus-boot.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <!--架构配置 -->
        <!--项目工具配置 -->
        <logback.version>1.5.18</logback.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <commons-lang3.version>3.15.0</commons-lang3.version> <!-- 兼容 JDK 21 -->
        <commons-io.version>2.16.0</commons-io.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <commons-collections4.version>4.4</commons-collections4.version> <!-- 兼容 JDK 21 -->
        <commons-cli.version>1.5.0</commons-cli.version> <!-- 兼容 JDK 21 -->
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <joda.time.version>2.12.5</joda.time.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <guava.version>33.4.8-jre</guava.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <fastjson.version>2.0.57</fastjson.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <lombok.version>1.18.36</lombok.version>
        <hutool-all.version>5.8.36</hutool-all.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <redisson-spring-boot.version>3.52.0</redisson-spring-boot.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <easyexcel.version>3.3.2</easyexcel.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <transmittable.version>2.14.3</transmittable.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <jpinyin.version>1.1.8</jpinyin.version> <!-- 该库较旧，未明确支持 JDK 21，需测试 -->
        <mockito-junit-jupiter.version>5.8.0</mockito-junit-jupiter.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <org.mapstruct.version>1.6.3</org.mapstruct.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <vertx.version>4.5.7</vertx.version> <!-- 兼容 JDK 21 -->
        <opentelemetry.version>1.34.0</opentelemetry.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <zxing.version>3.5.2</zxing.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <groovy.version>4.0.26</groovy.version> <!-- 升级到兼容 JDK 21 的版本 -->
        <bcprov.version>1.78</bcprov.version> <!-- 兼容 JDK 21 -->
        <fluent-validator-spring.version>1.0.9</fluent-validator-spring.version> <!-- 该库较旧，未明确支持 JDK 21，需测试 -->
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <springdoc.version>2.7.0</springdoc.version>
        <knife4j.version>4.4.0</knife4j.version>
        <jbcrypt.version>0.4</jbcrypt.version>
